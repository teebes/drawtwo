DJANGO_SETTINGS_MODULE=config.settings.development
# Keep this local-only signing key distinct from every deployed environment;
# never copy a production SECRET_KEY into DRAWTWO_DEV_SECRET_KEY.
DRAWTWO_DEV_SECRET_KEY=generate-a-unique-local-development-key
# Loopback is the safe default. Use 0.0.0.0 only for deliberate LAN/mobile
# testing, and never while running a production-derived database clone.
DRAWTWO_DEV_BIND_ADDRESS=127.0.0.1
DB_NAME=drawtwo
DB_USER=postgres
DB_PASSWORD=postgres
FRONTEND_URL=http://localhost:3000
FRONTEND_EMAIL_CONFIRM_URL=http://localhost:3000/auth/email-confirm
IOS_APP_LOGIN_URL=http://localhost:3000/app/login
IOS_LOGIN_URL_SCHEME=drawtwo://login
APPLE_SIGN_IN_TEAM_ID=your_apple_team_id
APPLE_SIGN_IN_KEY_ID=your_apple_key_id
APPLE_SIGN_IN_PRIVATE_KEY_HOST_PATH=/absolute/path/to/AuthKey_KEYID.p8
APPLE_SIGN_IN_PRIVATE_KEY_PATH=/run/secrets/drawtwo/apple-sign-in/AuthKey.p8
APPLE_SIGN_IN_WEB_CLIENT_ID=com.example.drawtwo.dev.web
APPLE_SIGN_IN_IOS_CLIENT_ID=com.example.drawtwo.dev
VITE_APPLE_REDIRECT_URI=https://drawtwo.com/auth/callback/apple
